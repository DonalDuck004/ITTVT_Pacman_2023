<Window x:Class="PacManWPF_Canvas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PacManWPF_Canvas"
        mc:Ignorable="d" Name="Self"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="GameWrapper">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Background="Blue" Grid.Row="0">
            <TextBlock Text="{Binding Fps, StringFormat='FPS: {0:F2}'}" FontSize="20" Foreground="Green"></TextBlock>
        </StackPanel>
        <Canvas Grid.Row="1" Background="Red">
            <Canvas Canvas.Left="32" Canvas.Top="32">
                <Rectangle Fill="Black" Width="64" Height="64"></Rectangle>
            </Canvas>

            <Canvas Canvas.Left="32" Canvas.Top="32">
                <Canvas.RenderTransform>
                    <TranslateTransform X="32" Y="32">
                        
                    </TranslateTransform>
                </Canvas.RenderTransform>
                <Rectangle Fill="White" Width="64" Height="64"></Rectangle>
            </Canvas>
        </Canvas>
        
    </Grid>
</Window>
